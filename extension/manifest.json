{
  "manifest_version": 3,
  "name": "西电智课 · 录播下载",
  "description": "识别西电智课回放中的 MP4，双路同步播放、选择声音和字幕，并保存视频到本地。",
  "version": "0.3.0",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "storage", "webRequest", "downloads"],
  "host_permissions": [
    "http://newes.chaoxing.com/*",
    "https://newes.chaoxing.com/*",
    "https://kdlbptvideo.xidian.edu.cn/*",
    "http://kdlbptvideo.xidian.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "西电智课录播下载",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_scripts": [{
    "matches": ["http://newes.chaoxing.com/*", "https://newes.chaoxing.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; media-src blob: https://kdlbptvideo.xidian.edu.cn http://kdlbptvideo.xidian.edu.cn; img-src 'self' data:; connect-src 'self' https://kdlbptvideo.xidian.edu.cn http://kdlbptvideo.xidian.edu.cn"
  }
}
